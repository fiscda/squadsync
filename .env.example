# Copy to .env (git-ignored) and fill in. `make` exports every variable here
# to both servers. See README.md for how to get the Discord values.

# --- Shared by Next.js and Go ---

# The one SQLite file both servers use. Relative paths are resolved from the
# repository root by the Makefile.
DATABASE_PATH=./data/squadsync.db

# Shared secret Next.js sends to Go on every internal API call. At least 32
# characters. Generate one with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Port of the Go internal API. Go listens on 127.0.0.1 only.
BACKEND_PORT=8081

# --- Next.js (Better Auth) ---

# Signs Better Auth sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL of the web app.
BETTER_AUTH_URL=http://localhost:3000

# From your Discord application's OAuth2 page (https://discord.com/developers/applications).
# Go uses them too, to exchange the code when someone links a further Discord
# account. Register both redirects there: <BETTER_AUTH_URL>/api/auth/callback/discord
# and <BETTER_AUTH_URL>/fiok/discord/callback (see README.md).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Go (Discord bot) ---

# The bot's token, from your Discord application's Bot page. Leave it empty to
# run Go without the bot. Go also needs BETTER_AUTH_URL above when this is set:
# the bot sends it as the login link.
DISCORD_BOT_TOKEN=
# Optional. A Discord server (guild) id: slash commands are then registered on
# that server only, where they update instantly. Empty registers them
# globally, which can take a while to appear. Use it for development.
DISCORD_DEV_GUILD_ID=
